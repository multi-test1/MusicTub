function showShorts() {
  document.querySelector("style#noutube-shorts")?.remove();
}

// content/dialogs.ts
var handled = false;
function handleDialogs() {
  if (handled) {
    return;
  }
  const target = document.querySelector("tp-yt-paper-dialog");
  if (!target) {
    return;
  }
  const observer = new MutationObserver((mutations) => {
    const dismissButton = target.querySelector("ytmusic-mealbar-promo-renderer .dismiss-button");
    if (dismissButton) {
      dismissButton.click();
    }
  });
  observer.observe(target, {
    attributes: true
  });
  handled = true;
}

