var revealTimer;
var getSide = () => localStorage.getItem(sideKey) === "right" ? "right" : "left";
function applySide(element) {
  element?.classList.toggle(rightClass, getSide() === "right");
}
function toggleSide() {
  localStorage.setItem(sideKey, getSide() === "right" ? "left" : "right");
  for (const id of [btnId, panelId, overlayId]) {
    applySide(document.getElementById(id));
  }
}
var getFullscreenElement = () => document.fullscreenElement || document.webkitFullscreenElement;
var getPlayer3 = () => document.getElementById("movie_player");
var isWebPlayer = () => !window.isAndroid;
var bridgeToken2 = () => window.NouTubeToken || "";
var hasNativeBrightness = () => typeof window.NouTubeI?.setBrightness == "function";
var hasNativeVolume = () => typeof window.NouTubeI?.setVolumeIndex == "function";
var swallowedEvents = [
