var fetchPlayerResponse = async (videoId) => {
  const context = ytcfgValue("INNERTUBE_CONTEXT");
  if (!context)
    return null;
  const key = ytcfgValue("INNERTUBE_API_KEY");
  const response = await fetch(`/youtubei/v1/player?prettyPrint=false${key ? `&key=${key}` : ""}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ context, videoId, contentCheckOk: true, racyCheckOk: true })
  });
  if (!response.ok)
    return null;
  const json = await response.json();
  const status = json?.playabilityStatus?.status;
  if (status && status !== "OK")
    return null;
  return trimResponse(json);
};
var getPlayerFormats = async (videoId) => fromCurrentPlayer(videoId) ?? fetchPlayerResponse(videoId).catch(() => null);

// lib/split-watch-url.ts
function isWatchUrl(value) {
  try {
    const url = new URL(value);
    return ["http:", "https:"].includes(url.protocol) && ["youtube.com", "www.youtube.com", "m.youtube.com"].includes(url.host) && url.pathname === "/watch";
  } catch {
    return false;
  }
}

// content/split-player-window.ts
function installSplitPlayerWindow(target = window) {
  Object.defineProperties(target, {
    outerWidth: { configurable: true, get: () => target.screen.width },
    outerHeight: { configurable: true, get: () => target.screen.height }
  });
}

// content/split-link.ts
function findSplitLink(event) {
  const path = typeof event.composedPath === "function" ? event.composedPath() : [];
  const target = event.target;
  const elements = [...path, target?.closest?.("a[href], ytm-home-logo")];
  for (const node of elements) {
    const element = node;
    if (element?.tagName === "A") {
      const anchor = element;
      const href = anchor.getAttribute("href");
      if (href)
        return { href, target: anchor.target };
    }
    if (element?.tagName === "YTM-HOME-LOGO") {
      return { href: "/" };
    }
  }
  return null;
}

// content/split-view.ts
