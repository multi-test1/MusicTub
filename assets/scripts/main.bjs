      native: false,
      max: 100 * maxBoost,
      value: volume < 100 ? volume : Math.round(boost * 100)
    };
  }
  return;
}
function setWebVolume(value) {
  setPlayerVolume(Math.min(value, 100));
  setBoost(value <= 100 ? 1 : value / 100);
}
var formatVolume = (value, max) => `${Math.round(hasNativeVolume() ? value / max * 100 : value)}%`;
function getAvailableQualities() {
  const levels = getPlayer3()?.getAvailableQualityLevels?.();
  const available = Array.isArray(levels) ? levels : [];
  return playbackQualities.filter((q) => q.value === "auto" || available.includes(q.value)).map((q) => q.value);
}
function getCurrentQuality() {
  const settings = parseJson(localStorage.getItem("nou:settings"), {});
  return typeof settings.playbackQuality == "string" ? settings.playbackQuality : "auto";
}
function paintSlider(input) {
  if (!input) {
    return;
  }
