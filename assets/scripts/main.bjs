      const options = {
        showOriginalVideoTitle: Boolean(settings?.showOriginalVideoTitle),
        blockAds: settings?.blockAds !== false
      };
      try {
        const fn = {
          browse: (text, blocklist) => transformBrowseResponse(text, blocklist, options),
          get_watch: (text) => transformGetWatchResponse(text, options),
          next: (text, blocklist) => transformBrowseResponse(text, blocklist, options),
          reel: (text, blocklist) => transformReelResponse(text, blocklist, options),
