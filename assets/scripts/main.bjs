`;
function renderPanelContent(panel) {
  const video = getVideoElement2();
  const rate = video ? video.playbackRate : getPlayer3()?.getPlaybackRate?.();
  const currentRate = typeof rate == "number" && Number.isFinite(rate) ? rate : 1;
  const currentQuality = getCurrentQuality();
  const brightness = getCurrentBrightness();
  const volume = getVolumeControl();
  const speedChips = playbackRatesWith(currentRate).map((r) => chip("rate", String(r), formatPlaybackRate(r), r === currentRate)).join("");
  const qualityChips = getAvailableQualities().map((q) => chip("quality", q, formatPlaybackQuality(q), q === currentQuality)).join("");
  panel.innerHTML = nouPolicy.createHTML(`
    <div class="${rowClass}">
      ${window.isAndroid ? `<button type="button" id="_nou_fs_lock">${iconLock}<span>Lock</span></button>` : ""}
      <button type="button" id="_nou_fs_side" aria-label="Switch side">${iconSwap}</button>
    </div>
    <div class="${rowClass}">
