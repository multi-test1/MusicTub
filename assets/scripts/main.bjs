  itag: format?.itag,
  mimeType: format?.mimeType,
  qualityLabel: format?.qualityLabel,
  height: format?.height,
  fps: format?.fps,
  bitrate: format?.bitrate,
  averageBitrate: format?.averageBitrate,
  contentLength: format?.contentLength
});
