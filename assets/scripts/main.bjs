  if (saved !== undefined) {
    applyBrightness(saved);
  }
}
function resetBrightness() {
  window.NouTubeI?.setBrightness?.(bridgeToken2(), -1);
}
function getVolumeSteps() {
  const steps = window.NouTubeI?.getVolumeSteps?.(bridgeToken2());
  return typeof steps == "number" && steps > 0 ? steps : 0;
}
function getVolumeIndex() {
  const index = window.NouTubeI?.getVolumeIndex?.(bridgeToken2());
  return typeof index == "number" && Number.isFinite(index) ? index : 0;
}
var hasPlayerVolume = () => typeof getPlayer3()?.setVolume == "function";
function getPlayerVolume() {
  const player = getPlayer3();
  if (player?.isMuted?.()) {
    return 0;
  }
  const volume = player?.getVolume?.();
  return typeof volume == "number" && Number.isFinite(volume) ? Math.round(volume) : 100;
}
function setPlayerVolume(value) {
  const player = getPlayer3();
  player?.setVolume?.(value);
  if (value > 0 && player?.isMuted?.()) {
    player.unMute?.();
  }
}
var getVideoElement2 = () => {
  const video = document.querySelector("#movie_player video") || document.querySelector("video");
  return video instanceof HTMLVideoElement ? video : null;
};
var maxBoost = 2;
var audioContext;
var gainNode;
var gainSource;
var boost = 1;
function getGainNode() {
  const video = getVideoElement2();
  if (!video) {
    return;
  }
  if (gainNode && gainSource === video) {
    return gainNode;
  }
  try {
    audioContext ||= new AudioContext;
    const source = audioContext.createMediaElementSource(video);
    gainNode = audioContext.createGain();
