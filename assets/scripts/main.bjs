var getCoreCss = () => {
  const isApp = Boolean(window.NouTubeI);
  const blockAds = window.NouTube?.getSettings?.()?.blockAds !== false;
  return (blockAds ? cssContentAds : "") + cssContent + (isApp ? cssContentMobile : cssContentDesktop) + cssFullscreenPanel;
};
var getInjectedCss = (userStyles) => {
  return [getCoreCss(), getCaptionCss(), getEnabledUserStyleCss(document.location.host, userStyles)].filter(Boolean).join(`

`);
};
function injectCSS() {
  const style = document.querySelector(`#${injectedStyleId}`) || document.createElement("style");
  const update = () => {
    const userStyles = window.NouTube?.getUserStyles?.();
    style.textContent = getInjectedCss(userStyles);
  };
  style.id = injectedStyleId;
  style.type = "text/css";
  update();
  (document.head || document.documentElement).appendChild(style);
  window.addEventListener(noutubeSettingsEvent, update);
  window.addEventListener(noutubeUserStylesEvent, update);
}
function hideShorts() {
