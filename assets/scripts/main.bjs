};
var fromCurrentPlayer = (videoId) => {
  try {
    const response = getPlayer()?.getPlayerResponse?.();
    if (!response || response?.videoDetails?.videoId !== videoId)
      return null;
    return trimResponse(response);
  } catch {
    return null;
  }
