    const mse = window.MediaSource;
    if (mse && typeof mse.isTypeSupported === "function") {
      const origIsTypeSupported = mse.isTypeSupported.bind(mse);
      mse.isTypeSupported = makeChecker(origIsTypeSupported);
    }
  } catch (e) {}
}

// content/clickbait.ts
var THUMB_RE = /^(https?:\/\/i\d?\.ytimg\.com\/(?:vi|vi_webp)\/[^/]+\/)(default|mqdefault|hqdefault|sddefault|hq720|hq1|hq2|hq3|maxresdefault)(_custom_\d+)?(\.[a-zA-Z0-9]+)(.*)$/;
