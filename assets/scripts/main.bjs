// lib/intercept.ts
var keys = ["adBreakHeartbeatParams", "adPlacements", "adSlots", "playerAds"];
var RE_INTERCEPT = new RegExp("^/youtubei/v1/(browse|get_watch|next|player|reel|search)");
var blocksAds = (options) => options.blockAds !== false;
